#!/usr/bin/env bash
# Resolve the pinned Rust cargo regardless of how the machine manages
# Rust, so CI and every local machine run the exact same compiler:
#
#   1. rustup (CI and standard dev boxes): `rustup run <version> cargo`.
#   2. A plain rustup toolchain layout without the rustup command
#      (owner dev box): the direct toolchain binary.
#   3. A `cargo` on PATH that already reports the pinned version (the
#      system toolchain, e.g. the nix-managed latest Rust).
#
# Anything else fails with a clear message -- never a silently different
# toolchain.
#
# Usage: scripts/cargo-pinned <version> [cargo args...]

set -euo pipefail

version="${1:?usage: scripts/cargo-pinned <version> [cargo args...]}"
shift

if command -v rustup >/dev/null 2>&1; then
    exec rustup run "$version" cargo "$@"
fi

for candidate in \
    "$HOME/.rustup/toolchains/${version}-x86_64-unknown-linux-gnu/bin/cargo" \
    "$HOME/.rustup/toolchains/${version}-aarch64-apple-darwin/bin/cargo"
do
    if [ -x "$candidate" ]; then
        exec "$candidate" "$@"
    fi
done

if command -v cargo >/dev/null 2>&1; then
    current="$(cargo --version 2>/dev/null || true)"
    if [[ "$current" == *"$version"* ]]; then
        exec cargo "$@"
    fi
fi

echo "omnirepo: cannot resolve Rust ${version} cargo (no rustup, no rustup toolchain, and PATH cargo is not ${version})" >&2
exit 2
