#!/usr/bin/env bash
# Resolve the pinned Rust 1.86.0 cargo regardless of how the machine
# manages Rust, so CI and every local machine run the exact same
# compiler:
#
#   1. rustup (CI and standard dev boxes): `rustup run 1.86.0 cargo`.
#   2. A plain rustup toolchain layout without the rustup command
#      (owner dev box): the direct toolchain binary.
#   3. A `cargo` on PATH that already reports 1.86.0.
#
# Anything else fails with a clear message -- never a silently different
# toolchain.

set -euo pipefail

if command -v rustup >/dev/null 2>&1; then
    exec rustup run 1.86.0 cargo "$@"
fi

for candidate in \
    "$HOME/.rustup/toolchains/1.86.0-x86_64-unknown-linux-gnu/bin/cargo" \
    "$HOME/.rustup/toolchains/1.86.0-aarch64-apple-darwin/bin/cargo"
do
    if [ -x "$candidate" ]; then
        exec "$candidate" "$@"
    fi
done

if command -v cargo >/dev/null 2>&1; then
    version="$(cargo --version 2>/dev/null || true)"
    if [[ "$version" == *"1.86.0"* ]]; then
        exec cargo "$@"
    fi
fi

echo "omnirepo: cannot resolve the pinned Rust 1.86.0 cargo (no rustup, no rustup toolchain, and PATH cargo is not 1.86.0)" >&2
exit 2
