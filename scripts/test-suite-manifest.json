    {
      "id": "component",
      "kind": "component",
      "cases": [
        {
          "id": "workspace-boundary-contract",
          "argv": [
            "cargo",
            "test",
            "--workspace",
            "--all-targets",
            "--all-features",
            "--locked",
            "--test",
            "workspace_boundary_contract"
          ],
          "working_directory": ".",
          "tags": ["repository", "component"]
        }
      ]
    },
    {
      "id": "e2e",
      "kind": "e2e",
      "cases": [
        {
          "id": "canonical-acceptance-journeys",
